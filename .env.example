# App
NODE_ENV=development
APP_NAME="New Home"
APP_URL=http://localhost:3000
API_URL=http://localhost:5000/api

# Frontend
NEXT_PUBLIC_APP_NAME="New Home"
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Backend
PORT=5000
SERVER_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000

# Database
DATABASE_URL="postgresql://newhome_user:new_home_password@localhost:5432/new_home_db?schema=public"

# PostgreSQL Docker
POSTGRES_USER=newhome_user
POSTGRES_PASSWORD=new_home_password
POSTGRES_DB=new_home_db
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=replace_with_strong_access_secret
JWT_REFRESH_SECRET=replace_with_strong_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie
COOKIE_SECRET=replace_with_cookie_secret
COOKIE_DOMAIN=localhost

# Super Admin Seed
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=superadmin@newhome.com
SUPER_ADMIN_PASSWORD=SuperAdmin@12345

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="New Home <no-reply@newhome.com>"

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# LangChain / AI
OPENAI_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=new-home

# Vector Database
VECTOR_STORE_PROVIDER=memory

# Security
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Socket
SOCKET_CORS_ORIGIN=http://localhost:3000

# File Upload
MAX_FILE_SIZE_MB=5
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp