{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "New Home Base TypeScript Config",
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": true,
    "baseUrl": ".",
    "paths": {
      "@new-home/database": [
        "packages/database/src"
      ],
      "@new-home/database/*": [
        "packages/database/src/*"
      ],
      "@new-home/shared": [
        "packages/shared/src"
      ],
      "@new-home/shared/*": [
        "packages/shared/src/*"
      ],
      "@new-home/web/*": [
        "apps/web/src/*"
      ],
      "@new-home/server/*": [
        "apps/server/src/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    "build",
    ".next",
    ".turbo"
  ]
}